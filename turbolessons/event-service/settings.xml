<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <!-- Auth for the GitHub Packages Maven repo (id 'github' in pom.xml). The token is provided
       at build time via the GH_PACKAGES_TOKEN env var (a read:packages PAT), injected as a
       BuildKit secret in the Dockerfile / passed by CI. -->
  <servers>
    <server>
      <id>github</id>
      <username>ntjohns1</username>
      <password>${env.GH_PACKAGES_TOKEN}</password>
    </server>
  </servers>
</settings>
